# Voice Commander for Discord. Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Your Discord bot's token (Developer Portal > your app > Bot > Reset Token).
DISCORD_BOT_TOKEN=
# Your server's ID (Discord: Settings > Advanced > Developer Mode, then right-click the server > Copy ID).
DVC_GUILD=
# Your own Discord user ID. Posts carry your name and avatar, and lock-screen pings mention you.
DVC_OWNER=

# --- Phone access -----------------------------------------------------------
# Tailscale logins that are signed in automatically (comma separated). Empty = access code only.
DVC_TAILNET_OWNERS=

# --- Optional ---------------------------------------------------------------
# Name shown on posts made through the app's webhook.
DVC_WEBHOOK_NAME=Voice Commander
# Your own channel or product names, so "how's <name> doing?" counts as a Discord question.
DVC_ROOM_WORDS=
# Set to 1 to require a spoken "yes" before every post (default: posts go out at once; say "undo").
DVC_CONFIRM=0
# GPT-Live voice and the text model, both on your ChatGPT sign-in (~/.codex/auth.json).
DVC_VOICE=cove
DVC_TEXT_MODEL=gpt-5.6-terra

# Brain: "direct" (default, built in) or "hermes" (a Hermes Agent profile, see README).
DVC_BRAIN=direct
# DVC_HERMES_URL=http://127.0.0.1:8642
# DVC_PROFILE=discord-voice
# DVC_HERMES_KEY=

PORT=3077
HOST=127.0.0.1
# Your time zone for "today"/"this morning" (default: the computer's).
# DVC_TZ=
